# ===== VYRA AI server (copy to .env locally; set these in Render for production) =====
PORT=8787

# --- Video providers ---
FAL_KEY=
HF_TOKEN=
# HF_VIDEO_MODEL=Wan-AI/Wan2.2-TI2V-5B

# --- Talking Fruits voices (ElevenLabs) ---
ELEVENLABS_API_KEY=
ELEVENLABS_MANGO_VOICE_ID=
ELEVENLABS_STRAWBERRY_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_v4

# --- Launch controls ---
VYRA_DAILY_LIMIT=5            # free videos per person per day (protects your provider bill)
VYRA_MAX_CONCURRENT=2         # videos rendered at the same time
VYRA_RETENTION_DAYS=7         # delete videos after N days
VYRA_ACCESS_CODES=
VYRA_MAINTENANCE=false        # true = pause creation and show a banner
VYRA_STORAGE_DIR=             # on Render use /var/data/videos (persistent disk)

# --- URLs ---
PUBLIC_API_URL=https://your-api.onrender.com
PUBLIC_APP_URL=https://your-app.vercel.app
CORS_ORIGINS=https://your-app.vercel.app

# ===== Expo app (set in Vercel / EAS, NOT secret) =====
# EXPO_PUBLIC_API_URL=https://your-api.onrender.com
