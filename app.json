{
    "expo":  {
                 "name":  "VYRA AI",
                 "slug":  "vyra-ai-cinematic-intelligence",
                 "version":  "2.0.0",
                 "orientation":  "portrait",
                 "icon":  "./assets/icon.png",
                 "userInterfaceStyle":  "dark",
                 "backgroundColor":  "#050a13",
                 "splash":  {
                                "image":  "./assets/splash-icon.png",
                                "resizeMode":  "contain",
                                "backgroundColor":  "#050a13"
                            },
                 "ios":  {
                             "supportsTablet":  true,
                             "bundleIdentifier":  "com.vyra.cinematic",
                             "infoPlist":  {
                                               "NSPhotoLibraryUsageDescription":  "VYRA uses a photo you choose to animate it into a video.",
                                               "ITSAppUsesNonExemptEncryption":  false
                                           }
                         },
                 "android":  {
                                 "package":  "com.vyra.cinematic",
                                 "adaptiveIcon":  {
                                                      "foregroundImage":  "./assets/android-icon-foreground.png",
                                                      "backgroundImage":  "./assets/android-icon-background.png",
                                                      "monochromeImage":  "./assets/android-icon-monochrome.png",
                                                      "backgroundColor":  "#050a13"
                                                  }
                             },
                 "web":  {
                             "bundler":  "metro",
                             "output":  "single",
                             "favicon":  "./assets/favicon.png"
                         },
                 "plugins":  [
                                 "expo-video",
                                 [
                                     "expo-image-picker",
                                     {
                                         "photosPermission":  "VYRA uses a photo you choose to animate it into a video."
                                     }
                                 ]
                             ],
                 "experiments":  {
                                     "baseUrl":  "/app"
                                 }
             }
}
